# Where the frontend finds the Aqualens API (public, build-time).
# Development: the local backend started from the repo root.
VITE_AQUALENS_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Production builds must set this (or VITE_API_BASE_URL) to the deployed API,
# e.g. https://aqualens-api.onrender.com/api/v1. Without it the workspace reports
# the service as unavailable instead of calling localhost.
