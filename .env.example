# --- Frontend (Vercel / Next.js) ---
# FastAPI backend origin (no trailing slash, no /api/v1 suffix — the frontend
# appends that). Defaults safely to http://127.0.0.1:8000 for local dev when unset.
# In production, set to the HTTPS URL of the deployed FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Backend (FastAPI) ---
# Comma-separated list of allowed CORS origins. Leave unset for local dev, which
# already permits http://localhost:<any-port> and http://127.0.0.1:<any-port>.
# Retained environment-variable names keep existing runtime configuration compatible.
# Required in production, e.g.: https://aqualens-web.vercel.app
SAGARDRISHTI_ALLOWED_ORIGINS=

# Path to the frozen YOLO11s .pt weights file. Leave unset locally to use the
# repo-relative default (ml/artifacts/final_v1/detector/best.pt). The Render
# service points to this bundled artifact in its Docker image.
SAGARDRISHTI_MODEL_PATH=

# Optional explicit location of the frozen open_set_v1 directory. Leave unset
# locally to use ./ml/artifacts/vnext/open_set_v1. When set, a missing or invalid
# directory makes the backend fail startup rather than silently disable it.
SAGARDRISHTI_OPEN_SET_DIR=

# Directory for runtime state (uploaded rasters, runtime_surveys.json, the
# reviews SQLite database). Leave unset locally to use ./data/runtime. In
# production this MUST be a persistent (non-ephemeral) disk mount, or survey
# and review state will be lost on every container replacement/redeploy.
SAGARDRISHTI_RUNTIME_DIR=

# Maximum accepted survey body in bytes. The default is 512 MiB. This caps the
# streamed upload before ZIP extraction; ensure persistent disk capacity also
# covers extracted rasters.
SAGARDRISHTI_MAX_UPLOAD_BYTES=536870912

# Host-provided port for the production uvicorn process (see docs/DEPLOYMENT.md).
# Not read by the app directly; passed to uvicorn's --port flag.
PORT=8000
